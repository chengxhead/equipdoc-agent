# Safe default: no 7B model or CNN weight is required.
EQUIPDOC_DEMO_MODE=true

# P2.1 opt-in: LLM intent planning, bounded tools, short-term memory and grounded synthesis.
# This is used only when DEMO_MODE=false. Keep false to reproduce the published P2 baseline.
EQUIPDOC_AGENTIC_MODE=false
EQUIPDOC_AGENT_MAX_STEPS=3

# OpenAI-compatible LLM service. Used only when DEMO_MODE=false.
EQUIPDOC_LLM_BASE_URL=http://127.0.0.1:8000/v1
EQUIPDOC_LLM_MODEL=qwen-equipdoc
EQUIPDOC_LLM_API_KEY=EMPTY
EQUIPDOC_LLM_TIMEOUT_SECONDS=120

# Local model/data paths. Relative paths are resolved from the repository root.
EQUIPDOC_BEARING_MODEL_PATH=models/bearing_cnn.pth
EQUIPDOC_BEARING_NORM_PATH=data/processed/norm.npy
EQUIPDOC_SAMPLE_ROOT=data/samples
EQUIPDOC_UPLOAD_ROOT=runtime/uploads
EQUIPDOC_MAX_UPLOAD_MB=8
EQUIPDOC_UPLOAD_TTL_HOURS=24

# RAG is optional. With no vector DB the application degrades explicitly.
EQUIPDOC_RAG_ENABLED=true
EQUIPDOC_RAG_CHUNKS_PATH=data/knowledge_chunks.jsonl
EQUIPDOC_RAG_DB_DIR=vector_db/chroma_equipdoc
EQUIPDOC_RAG_COLLECTION=equipdoc_rag
EQUIPDOC_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EQUIPDOC_RAG_TOP_K=5

# Web UI
EQUIPDOC_SERVER_HOST=0.0.0.0
EQUIPDOC_SERVER_PORT=7860
EQUIPDOC_GRADIO_SHARE=false
